{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["vite/client"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,

    /* Path aliases */
    "paths": {
      "@/*": ["./src/*"],
      "@components/*": ["./src/components/*"],
      "@fixtures/*": ["./src/fixtures/*"],
      "@pages/*": ["./src/pages/*"],
      "@assets/*": ["./src/stubs/assets/*"],
      "@constants/*": ["./src/stubs/constants/*"],
      "@hooks/*": ["./src/stubs/hooks/*"],
      "@services/*": ["./src/stubs/services/*"],
      "@tanstack/react-router": ["./src/stubs/tanstack/react-router"],
      "@shared/*": ["./src/stubs/shared/*"],
      "@stores/*": ["./src/stubs/stores/*"],
      "@zcentral-v2/constants": ["./src/stubs/zcentral-v2/constants"],
      "@zcentral-v2/search": ["./src/stubs/zcentral-v2/search"],
      "@zcentral-v2/types": ["./src/stubs/zcentral-v2/types"],
      "@zcentral-v2/utils": ["./src/stubs/zcentral-v2/utils"]
    },

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    /* Off: the ported zCentral components use plain `import { FC }` rather
       than `import type`, and rewriting ~90 files to satisfy this would
       make every future re-sync from the source project a conflict. */
    "verbatimModuleSyntax": false,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    /* Off: the design system leans on `enum` (ContentBadgeType,
       ContentPlatform, ...), which this flag bans. */
    "erasableSyntaxOnly": false,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"]
}
